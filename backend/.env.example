#
# Daily Trends – Scraper configuration
#
# Copy to backend/.env. Without RAPIDAPI_KEY the scraper exits cleanly without
# touching the database, so the shop keeps serving the data it already has.
#

# RapidAPI key for "Real-Time Amazon Data".
# Free tier: 100 requests/day — https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-amazon-data
RAPIDAPI_KEY=

# Amazon marketplace to query.
RAPIDAPI_COUNTRY=DE

# Hard cap on API calls per run. A full sync needs ~37; the default leaves head
# room inside the free tier's 100/day.
MAX_API_CALLS=80

# Must match the frontend setting — both processes open the same SQLite file.
# DATABASE_PATH=data/daily-trends.db
